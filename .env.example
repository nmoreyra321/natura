# =====================================================================
# Natu Mariel — variables de entorno
# Copiá este archivo como .env.local para desarrollo. En producción se cargan
# en Vercel → Project Settings → Environment Variables.
# NO pongas valores reales en este archivo: se sube al repositorio.
# =====================================================================

# --- Sitio ------------------------------------------------------------
# Dirección pública definitiva (para sitemap, Open Graph y enlaces de WhatsApp).
# Opcional: si falta, en Vercel se usa el dominio de producción del proyecto.
NEXT_PUBLIC_SITE_URL=

# --- Supabase (base de datos, login y fotos) ---------------------------
# Supabase → Project Settings → API (o "Connect").
NEXT_PUBLIC_SUPABASE_URL=
# Clave PÚBLICA. Usá la "publishable key" (sb_publishable_...) o la "anon key".
# Es segura para el navegador: los permisos los controla RLS en la base.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Solo para scripts locales (NUNCA en el navegador ni con prefijo NEXT_PUBLIC_) ---
# Se usa únicamente para crear la cuenta administradora con `npm run admin:create`.
# No hace falta cargarla en Vercel: la app no la usa.
SUPABASE_SECRET_KEY=

# --- WhatsApp (pendiente) ---------------------------------------------
# Número que recibe los pedidos, formato internacional solo con dígitos.
# Celular de Argentina: 549 + código de área sin 0 + número sin 15.
# Ejemplo de formato (no real): 5491100000000
# Mientras esté vacío, el botón de pedido se muestra deshabilitado.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Mercado Pago (opcional). Access Token de producción de la cuenta que cobra:
# mercadopago.com.ar/developers → Tus integraciones → (tu aplicación) → Credenciales de producción.
# Es secreto: nunca con prefijo NEXT_PUBLIC_. Sin esta variable, el carrito solo ofrece efectivo.
MP_ACCESS_TOKEN=
